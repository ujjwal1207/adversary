# Storage -------------------------------------------------------------------
# Default is SQLite at ./adversary.sqlite; nothing needs to be set to run.
ADVERSARY_DB_DIALECT=sqlite
ADVERSARY_SQLITE_PATH=./adversary.sqlite
# Postgres is supported via a single config change. Both are tested in CI.
# ADVERSARY_DB_DIALECT=postgres
# ADVERSARY_PG_URL=postgres://postgres:postgres@localhost:5432/adversary

# Money rail ----------------------------------------------------------------
# 'mock' needs no credentials. 'live-test' requires a payment provider TEST key
# and refuses to initialise on anything else (docs/THREAT-MODEL.md).
ADVERSARY_RAIL=mock
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Model ---------------------------------------------------------------------
# Only needed for the Ops / NaiveOps reference agents. ScriptedAgent needs none,
# which is why CI runs the whole corpus with no key present - and why the
# determinism gate can be a required check.
#
# Whichever key is set selects the provider; Anthropic wins if both are.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
ADVERSARY_MODEL=claude-sonnet-4-5

# Cassettes -----------------------------------------------------------------
# A hosted model is not deterministic even at temperature 0, so an LLM-backed
# run is not byte-reproducible. Record its responses once and replay them
# afterwards, and the run becomes reproducible *given that cassette* - which is
# a true statement rather than a hopeful one (docs/ARCHITECTURE.md 9.4).
#
# Both variables are required together. A path with no mode is refused rather
# than guessed: guessing 'record' would overwrite a recording.
#
# ADVERSARY_CASSETTE=.cassettes/B1.json
# ADVERSARY_CASSETTE_MODE=replay
