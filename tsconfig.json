{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@adversary/core": [
        "packages/core/src/index.ts"
      ],
      "@adversary/core/contracts": [
        "packages/core/src/contracts.ts"
      ],
      "@adversary/gate": [
        "packages/gate/src/index.ts"
      ],
      "@adversary/rails": [
        "packages/rails/src/index.ts"
      ],
      "@adversary/agents": [
        "packages/agents/src/index.ts"
      ],
      "@adversary/runner": [
        "packages/runner/src/index.ts"
      ],
      "@adversary/report": [
        "packages/report/src/index.ts"
      ],
      "@adversary/core/money": [
        "packages/core/src/money.ts"
      ]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "*.config.ts",
    "eslint.config.js"
  ],
  "exclude": [
    "**/dist/**",
    "**/node_modules/**"
  ]
}
